# Copy to .env (never commit the real one)
CALENDAR_ID=your-gmail@gmail.com
# Service-account JSON (single line). Calendar must be shared with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "", "private_key_id": "", "private_key": "", "client_email": "", "client_id": ""}
# Comma-separated origins allowed to call the API
ORIGINS=https://your-custom-web-form.com,http://localhost:8080
